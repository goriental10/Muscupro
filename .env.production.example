NODE_ENV=production

# Railway API
DATABASE_URL=******host:5432/muscupro
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
WEB_ORIGIN=https://app.example.com
PORT=4000

# GPT Action OAuth (optional — required only if you enable the ChatGPT GPT Action)
OAUTH_CLIENT_ID=replace-with-client-id-from-chatgpt-gpt-editor
OAUTH_CLIENT_SECRET=replace-with-client-secret-at-least-16-characters
OAUTH_REDIRECT_URIS=https://chat.openai.com/aip/YOUR_PLUGIN_ID/oauth/callback
API_BASE_URL=https://api.example.com

# Vercel Web
API_URL=https://api.example.com
AUTH_SECRET=replace-with-an-independent-long-random-secret
