{
  "name": "@muscupro/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "build": "expo export --platform android --output-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/features/health/summary.test.ts",
    "doctor": "expo-doctor",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "native:prebuild": "expo prebuild --no-install",
    "eas:preview": "eas build --profile preview --platform all",
    "eas:production": "eas build --profile production --platform all"
  },
  "dependencies": {
    "@kingstinct/react-native-healthkit": "^14.0.2",
    "expo": "~57.0.0",
    "expo-build-properties": "~57.0.2",
    "expo-constants": "~57.0.10",
    "expo-dev-client": "~57.0.2",
    "expo-router": "~57.0.2",
    "expo-secure-store": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-health-connect": "^4.1.3",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "eas-cli": "^21.8.0",
    "expo-doctor": "^1.20.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  }
}
